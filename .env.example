# HTTP server
PORT=3334
HOST=0.0.0.0

# Shared secret required on every /api/v1 request:
#   Authorization: Bearer <MANAGED_TEMPLATE_API_KEY>
MANAGED_TEMPLATE_API_KEY=

# Comma-separated list of allowed browser origins for CORS.
# Leave empty when only server-side clients call this API.
MANAGED_TEMPLATE_API_CORS_ORIGINS=

# Path to the module that builds your ManagedTemplateService (see README).
# Relative paths resolve from the process working directory.
# Compiled server (npm start): ./dist/vintasend-templates.config.js
# Dev server (npm run dev), which runs TypeScript directly: ./src/vintasend-templates.config.ts
MANAGED_TEMPLATE_SERVICE_MODULE=./dist/vintasend-templates.config.js
